    <string name="import_help_sub">Where to find the export in popular apps</string>
    <string name="import_help_simplenote_name">Simplenote</string>
    <string name="import_help_simplenote">Settings → Tools → Export Notes (web or desktop). Pick the .json file, or the .zip with it.</string>
    <string name="import_help_keep_name">Google Keep</string>
    <string name="import_help_keep">takeout.google.com → deselect all, tick only Keep, create the export. Pick the .zip or the .json files from it.</string>
    <string name="import_help_evernote_name">Evernote</string>
    <string name="import_help_evernote">Desktop app: select notes → right-click → Export → ENEX. Pick the .enex file.</string>
    <string name="import_help_sn_name">Standard Notes</string>
    <string name="import_help_sn">Preferences → Backups → Data Backups → Decrypted. Pick the .zip or the .txt backup file inside it.</string>
    <string name="import_help_joplin_name">Joplin</string>
    <string name="import_help_joplin">File → Export all → MD (Markdown). Pick the files or a .zip of them.</string>
    <string name="import_help_bear_name">Bear</string>
    <string name="import_help_bear">File → Export Notes → Markdown or Text. Pick the files or a .zip of them.</string>
    <string name="import_help_notion_name">Notion</string>
    <string name="import_help_notion">Settings → General → Export all workspace content → Markdown &amp; CSV. Pick the .zip.</string>
    <string name="import_help_obsidian_name">Obsidian</string>
    <string name="import_help_obsidian">Notes are plain .md files in your vault folder. Pick the files or a .zip of the folder.</string>
    <string name="import_help_other_name">Markor, others</string>
    <string name="import_help_other">Any Markdown or text files, or a .zip with them.</string>
    <string name="import_help_footer">You can pick several files at once. Notes that are already in Cotes are skipped, tags become #tags at the end of a note, and notes from the trash are left out.</string>
